general {
        output_format = "i3bar"
        colors = true
        color_good = "#9ccfd8"
        color_degraded = "#f6c177"
        color_bad = "#eb6f92"
        interval = 1
}

order += "volume master"
order += "cpu_temperature 0"
order += "wireless wlp2s0"
order += "ethernet enp3s0"
order += "disk /"
order += "disk /mnt/drive_b"
order += "load"
order += "memory"
order += "tztime local"

volume master {
        format = "♪ %volume"
        format_muted = "♪ muted"
        device = "pulse"
}

cpu_temperature 0 {
        format = "%degrees°C"
        path = "/sys/class/thermal/thermal_zone1/temp"
}

wireless wlp2s0 {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet enp3s0 {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

disk "/" {
        format = "/ %avail"
}

disk "/mnt/drive_b" {
        format = "drive_b %avail"
}

load {
        format = "L: %1min"
}

memory {
        format = "M: %percentage_used"
        threshold_degraded = "10%"
        format_degraded = "MEM < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}
